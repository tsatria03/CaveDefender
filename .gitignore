.claude
New File*.txt

# Python bytecode cache
__pycache__/

# Compiled release builds
release/
user/

# Binary engine libraries (DLLs + bundled tools.
cf/client/lib/
cf/server/lib/

# Live player accounts (passwords, emails, stats). Private data; the repo is public.
cf/server/data/host/game/players/

# Compile-error reports written by the launchers (cfc.py, cfs.py) when a script fails to compile.
cf/client/errors.txt
cf/server/errors.txt

# Test output (results and progress logs) written when a test under tests/ runs.
tests/**/*.txt

# Player-submitted feedback and reports, written by the running server. Private data.
cf/server/data/host/main/feedback.svr
cf/server/data/host/main/reports.svr
